// Linux template: cp container/linux/devcontainer.json .devcontainer/ and uncomment your GPU option.
{
  "name": "evtol-devcontainer",
  "build": { "dockerfile": "../container/image/Dockerfile", "context": "../container/image" },
  // Or use a prebuilt image instead of "build":
  // "image": "ghcr.io/<user>/evtol-devcontainer@sha256:<digest>",

  /// Writes an X cookie for Gazebo's window to $XDG_RUNTIME_DIR
  "initializeCommand": "bash container/xauth.sh",

  "runArgs": [
    /// [NVIDIA] GPU through CDI (Podman, or Docker 25+ with the NVIDIA toolkit)
    // "--device=nvidia.com/gpu=all",

    /// [Intel/AMD] Needs the groups owning /dev/dri/renderD128 and /dev/dri/card0
    // "--device=/dev/dri",
    // "--group-add=keep-groups",               // rootless Podman
    // "--group-add=109", "--group-add=44",     // Docker: stat -c %g /dev/dri/renderD128 /dev/dri/card0

    /// Lets Gazebo open the X socket on SELinux/AppArmor distros
    "--security-opt=label=disable",
    "--network=host",

    /// Shared memory for Fast DDS and Gazebo (the default is 64 MB)
    "--shm-size=1g"
  ],

  "mounts": [
    /// X server socket and the cookie written by xauth.sh
    "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,readonly",
    "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/px4-devcontainer.xauth,target=/tmp/px4.xauth,readonly",

    /// The team's models/worlds repo, cloned next to this workspace
    "type=bind,source=${localWorkspaceFolder}/../PX4-gazebo-models,target=/home/user/PX4-gazebo-models",

    /// Caches and data that survive rebuilds
    "type=volume,source=evtol-ccache,target=/home/user/.ccache",
    "type=volume,source=evtol-gz-fuel,target=/home/user/.gz/fuel",
    "type=volume,source=evtol-ros-home,target=/home/user/.ros",
    "type=volume,source=evtol-mission-logs,target=/home/user/evtol/mission_logs",
    "type=volume,source=evtol-claude,target=/home/user/.claude"
  ],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/px4.xauth",

    /// [NVIDIA] PRIME offload on hybrid laptops
    // "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics,display",
    // "__NV_PRIME_RENDER_OFFLOAD": "1",
    // "__GLX_VENDOR_LIBRARY_NAME": "nvidia",

    /// [No GPU] Software rendering
    // "LIBGL_ALWAYS_SOFTWARE": "1",

    "CCACHE_DIR": "/home/user/.ccache",
    "CCACHE_MAXSIZE": "10G",
    "QT_QPA_PLATFORM": "xcb",
    "CLAUDE_CONFIG_DIR": "/home/user/.claude"
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.102.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24.21.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  },

  /// The image has no folder for the Claude Code volume, so it is mounted as root
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" ~/.claude; (sudo apt-get update || echo \"apt-get update failed; run it before rosdep install\"); (rosdep update --rosdistro humble || echo \"rosdep update failed; using the cached data\")",

  "containerUser": "user",
  "remoteUser": "user",
  "updateRemoteUserUID": true
}
