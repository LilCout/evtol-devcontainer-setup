# Workspace manifest for the eVTOL ITA ROS 2 workspace.
#
# Usage (from the workspace root):
#   vcs import src < evtol.repos
#
# Os repositorios da equipe acompanham a `main`; os de terceiros ficam na
# imagem (container/image/deps.repos). Para registrar exatamente o que voou, rode
# scripts/congelar.sh, que gera o voo.repos.

repositories:

  # ---------- Layer 0: shared message/service interfaces ----------
  custom_msgs:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/custom_msgs.git
    version: main

  # ---------- Layer 1: PX4 hardware abstraction ----------
  drone_lib:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/drone_lib.git
    version: main

  # ---------- Layer 1: ArduPilot hardware abstraction ----------
  # Ponte MAVLink <-> micro-ROS por ESP32. So ozzy_bridge/ e pacote colcon;
  # firmware/ e um projeto PlatformIO.
  ozzy_bridge:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/ozzy_bridge.git
    version: main

  # ---------- Layer 2: perception ----------
  camera_publisher:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/camera_publisher.git
    version: main
  cv_nodes:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/cv_nodes.git
    version: main
  vision_geometry:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/vision_geometry.git
    version: main

  # ---------- Layer 4: behavior ----------
  fsm:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/fsm.git
    version: main
  stdstates:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/stdstates.git
    version: main
  stdbt:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/stdbt.git
    version: main

  # ---------- Layer 4: geometria pura e simulação ----------
  maze_geometry:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/maze_geometry.git
    version: main

  # slam_bridge: fora do manifesto ate o package.xml usar a chave rosdep
  # `eigen` em vez de `Eigen3`, que quebra o `rosdep install` do workspace.
  #   type: git
  #   url: https://github.com/Equipe-eVTOL-ITA/slam_bridge.git
  #   version: 0946ce327c7c9aa067a93dde65b75b5c85aabab6

  sim2d:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/sim2d.git
    version: main

  # ---------- Cross-cutting ----------
  telemetry_handler:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/telemetry_handler.git
    version: main

  # ---------- Layer 5: competition ----------
  cbr2026:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/cbr2026.git
    version: main
  ensaio_em_voo:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/ensaio_em_voo.git
    version: main
