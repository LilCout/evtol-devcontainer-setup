# A raiz do workspace colcon é dev/.

# Repositórios do workspace, trazidos por `vcs import src < evtol.repos`
/dev/src/

# Modelos e mundos do Gazebo, trazidos pelo sim.repos
/PX4-gazebo-models/

# Rosbags e saídas das missões (~/evtol/mission_logs aponta para cá)
/mission_logs/

# Configuração local do Dev Container, copiada de container/{linux,windows}/
/.devcontainer/

# Saídas do colcon
/dev/build/
/dev/install/
/dev/log/

# Python
__pycache__/
*.py[cod]
.venv/

# Editor / sistema
*.swp
.DS_Store

# Configuração local do Claude Code
**/.claude/settings.local.json

# VS Code: pessoal, exceto as tasks, que são do time
/dev/.vscode/*
!/dev/.vscode/tasks.json

# Clones de competições antigas, para consulta (o COLCON_IGNORE é versionado)
/dev/referencia/*/

# Manifesto congelado por scripts/congelar.sh
voo.repos
