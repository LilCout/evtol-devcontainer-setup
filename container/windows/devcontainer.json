// Windows (WSL 2) template: cp container/windows/devcontainer.json .devcontainer/ and uncomment your GPU option.
{
  "name": "evtol-devcontainer",
  /// ghcr.io/lilcout/evtol-devcontainer:humble-px4-1.15.4
  "image": "ghcr.io/lilcout/evtol-devcontainer@sha256:05a8898f2e6ad0e0b9a17434df058d53e7b8b58735f1a3bf811cc9b3f6d06513",
  // Or build the image from container/image/ instead of "image":
  // "build": { "dockerfile": "../container/image/Dockerfile", "context": "../container/image" },

  "runArgs": [
    /// [GPU] WSL's GPU device
    // "--device=/dev/dxg",

    /// [USB] A serial device attached to WSL (usbipd attach --wsl) before the container starts.
    /// ls /dev/ttyACM* /dev/ttyUSB* in WSL shows its name
    // "--device=/dev/ttyACM0",
    // "--group-add=keep-groups",               // rootless Podman
    // "--group-add=20",                        // Docker: stat -c %g /dev/ttyACM0

    "--network=host",

    /// Shared memory for Fast DDS and Gazebo (the default is 64 MB)
    "--shm-size=1g"
  ],

  /// VS Code opens dev/; the models and logs sit next to it
  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename}",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/dev",

  "mounts": [
    /// WSLg's X server
    "type=bind,source=/mnt/wslg/.X11-unix,target=/tmp/.X11-unix,readonly",

    /// [GPU] WSL's GPU driver libraries
    // "type=bind,source=/usr/lib/wsl,target=/usr/lib/wsl,readonly",

    /// Caches and data that survive rebuilds
    "type=volume,source=evtol-ccache,target=/home/user/.ccache",
    "type=volume,source=evtol-gz-fuel,target=/home/user/.gz/fuel",
    "type=volume,source=evtol-ros-home,target=/home/user/.ros",
    "type=volume,source=evtol-claude,target=/home/user/.claude"
  ],

  "containerEnv": {
    "DISPLAY": ":0",

    /// [GPU] Mesa's d3d12 driver; with several GPUs pick "NVIDIA", "Intel" or "AMD"
    // "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
    // "MESA_D3D12_DEFAULT_ADAPTER_NAME": "NVIDIA",

    /// [No GPU] Software rendering
    // "LIBGL_ALWAYS_SOFTWARE": "1",

    "CCACHE_DIR": "/home/user/.ccache",
    "CCACHE_MAXSIZE": "10G",
    "QT_QPA_PLATFORM": "xcb",
    "CLAUDE_CONFIG_DIR": "/home/user/.claude",

    /// The team's models/worlds repo, cloned by scripts/setup.sh
    "PX4_GZ_MODELS": "/workspaces/${localWorkspaceFolderBasename}/PX4-gazebo-models"
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.102.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24.21.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },

  "customizations": {
    "vscode": {
      /// The repo's root is the parent of dev/
      "settings": { "git.openRepositoryInParentFolders": "always" },
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  },

  /// The image has no folder for the Claude Code volume, so it is mounted as root.
  /// The links give evtol-dev's paths; the image has ~/evtol/mission_logs as an empty folder.
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" ~/.claude; ln -sfn \"$PX4_GZ_MODELS\" ~/PX4-gazebo-models; mkdir -p ../mission_logs && rmdir ~/evtol/mission_logs && ln -s \"/workspaces/${localWorkspaceFolderBasename}/mission_logs\" ~/evtol/mission_logs; ln -sfn \"/workspaces/${localWorkspaceFolderBasename}/dev\" ~/evtol/dev; (sudo apt-get update || echo \"apt-get update failed; run it before rosdep install\"); (rosdep update --rosdistro humble || echo \"rosdep update failed; using the cached data\")",

  "containerUser": "user",
  "remoteUser": "user",
  "updateRemoteUserUID": true
}
