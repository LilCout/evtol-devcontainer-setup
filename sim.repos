# Modelos e mundos do Gazebo da equipe, ao lado de dev/: fora do workspace
# colcon, que acharia o CMakeLists.txt do sdf_parsing/. Acompanha a `main`,
# como o evtol.repos.
#
# Uso (da raiz do repositório):
#   vcs import . < sim.repos

repositories:
  PX4-gazebo-models:
    type: git
    url: https://github.com/Equipe-eVTOL-ITA/PX4-gazebo-models.git
    version: main
