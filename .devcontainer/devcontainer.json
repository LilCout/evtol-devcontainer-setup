{
  "name": "evtol-devcontainer",
  "image": "ghcr.io/lilcout/evtol-devcontainer@sha256:05a8898f2e6ad0e0b9a17434df058d53e7b8b58735f1a3bf811cc9b3f6d06513",

  /// [Linux] Writes an X cookie for Gazebo's window to $XDG_RUNTIME_DIR.
  "initializeCommand": "bash container/xauth.sh",

  "runArgs": [
    /// [Linux - NVIDIA GPU rendering] GPU through CDI (Podman and Docker 25+ with the NVIDIA toolkit)
    "--device=nvidia.com/gpu=all",

    /// [Linux - Intel/AMD GPU rendering]
    /// The user needs the groups that own
    /// /dev/dri/renderD128 (`render`) and /dev/dri/card0 (`video`).
    /// With Docker, check the ids with `stat -c %g /dev/dri/renderD128 /dev/dri/card0`.
    // "--device=/dev/dri",
    // "--group-add=keep-groups",               // rootless Podman
    // "--group-add=109", "--group-add=44",     // Docker (your ids)

    /// [Windows - GPU rendering]
    // "--device=/dev/dxg",

    /// Disables SELinux/AppArmor label checks on Fedora-based distros, so Gazebo can open the X socket.
    "--security-opt=label=disable",

    /// Host network
    "--network=host",

    /// Shared memory for Fast DDS and Gazebo (the default is 64 MB)
    "--shm-size=1g"
  ],

  "mounts": [
    /// [Linux] X server socket and the cookie written by xauth.sh
    "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,readonly",
    "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/px4-devcontainer.xauth,target=/tmp/px4.xauth,readonly",

    /// [Windows]: WSLg's X server and WSL's GPU driver libraries (LD_LIBRARY_PATH)
    // "type=bind,source=/mnt/wslg/.X11-unix,target=/tmp/.X11-unix,readonly",
    // "type=bind,source=/usr/lib/wsl,target=/usr/lib/wsl,readonly",

    /// The team's models/worlds repo, cloned next to this workspace
    "type=bind,source=${localWorkspaceFolder}/../PX4-gazebo-models,target=/home/user/PX4-gazebo-models",

    /// Caches that survive image rebuilds (volumes managed by Podman/Docker):
    ///   ccache: compiled objects for PX4 and colcon builds
    ///   Gazebo Fuel: models and worlds downloaded from app.gazebosim.org
    ///   ~/.ros: ROS logs and the rosdep cache (refreshed by postCreateCommand)
    "type=volume,source=evtol-ccache,target=/home/user/.ccache",
    "type=volume,source=evtol-gz-fuel,target=/home/user/.gz/fuel",
    "type=volume,source=evtol-ros-home,target=/home/user/.ros",

    /// Data that must survive container rebuilds:
    ///   mission logs: the rosbag each mission launch records
    ///   Claude Code: login, settings and history (see CLAUDE_CONFIG_DIR)
    "type=volume,source=evtol-mission-logs,target=/home/user/evtol/mission_logs",
    "type=volume,source=evtol-claude,target=/home/user/.claude"
  ],

  "containerEnv": {
    /// [Linux] Display cookie
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/px4.xauth",

    /// [Windows]
    // "DISPLAY": ":0",

    /// [Windows - GPU rendering] WSL's GPU libraries for Mesa's d3d12 driver
    /// For multiple GPUs, choose between "NVIDIA", "Intel" and "AMD"
    // "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
    // "MESA_D3D12_DEFAULT_ADAPTER_NAME": "NVIDIA",

    /// [Linux - NVIDIA GPU rendering] PRIME offload on hybrid laptops
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics,display",
    "__NV_PRIME_RENDER_OFFLOAD": "1",
    "__GLX_VENDOR_LIBRARY_NAME": "nvidia",

    /// Software rendering (disable GPU acceleration)
    // "LIBGL_ALWAYS_SOFTWARE": "1",

    /// ccache
    "CCACHE_DIR": "/home/user/.ccache",
    "CCACHE_MAXSIZE": "10G",

    /// Qt (Gazebo's GUI) through X11/XWayland
    "QT_QPA_PLATFORM": "xcb",

    /// Claude Code keeps all its state in the evtol-claude volume
    "CLAUDE_CONFIG_DIR": "/home/user/.claude"
  },

  /// Developer tools, installed when the container is created, on top of the image.
  /// Claude Code is installed with npm, which the Node.js feature provides.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.102.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24.21.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },

  /// VS Code extensions in the container
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",       // ROS 2: launch files, run/debug nodes
        "ms-vscode.cpptools-extension-pack",   // C/C++ IntelliSense, debugger, CMake Tools
        "ms-python.python",                    // Python, Pylance, debugger
        "redhat.vscode-xml",                   // package.xml, launch XML, SDF worlds/models, Behavior Tree XML
        "redhat.vscode-yaml",                  // ROS params, mission YAML
        "timonwong.shellcheck"                 // lint for the bash scripts
      ]
    }
  },

  /// The image has no folders for the mission-logs and Claude Code volumes, so they
  /// are mounted as root; hand them to `user` (uid already updated at this point).
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" ~/evtol/mission_logs ~/.claude; (sudo apt-get update || echo \"apt-get update failed; package lists are empty, so rosdep install will fail until you run: sudo apt-get update\"); (rosdep update --rosdistro humble || echo \"rosdep update failed; using the cached rosdep data\")",

  /// Run as the image's non-root `user`. On Linux the Dev Containers CLI gives it
  /// your uid/gid, so files created in the workspace are yours (Docker); with
  /// rootless Podman the CLI also adds --userns=keep-id (Dev Containers CLI 0.76+).
  "containerUser": "user",
  "remoteUser": "user",
  "updateRemoteUserUID": true
}
